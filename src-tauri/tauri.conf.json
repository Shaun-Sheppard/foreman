{
  "$schema": "../node_modules/@tauri-apps/cli/config.schema.json",
  "productName": "Foreman",
  "version": "0.1.0",
  "identifier": "uk.co.shepparddigital.foreman",
  "build": {
    "frontendDist": "../dist/foreman/browser",
    "devUrl": "http://localhost:4200",
    "beforeDevCommand": "npm run build:host && npm run start",
    "beforeBuildCommand": "npm run build:host && npm run build"
  },
  "app": {
    "windows": [
      {
        "label": "main",
        "title": "Foreman",
        "width": 1280,
        "height": 800,
        "minWidth": 900,
        "minHeight": 560,
        "decorations": false,
        "resizable": true,
        "transparent": true,
        "shadow": true
      }
    ],
    "security": {
      "csp": {
        "default-src": "'self'",
        "script-src": "'self'",
        "style-src": "'self' 'unsafe-inline'",
        "font-src": "'self'",
        "img-src": "'self' data:",
        "connect-src": "ipc: http://ipc.localhost",
        "object-src": "'none'",
        "base-uri": "'self'",
        "form-action": "'none'"
      },
      "dangerousDisableAssetCspModification": [
        "style-src"
      ]
    },
    "macOSPrivateApi": true
  },
  "bundle": {
    "active": true,
    "targets": "all",
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.icns",
      "icons/icon.ico"
    ]
  }
}